# --- обязательное ---
DISCORD_TOKEN=

# --- основное ---
# Префикс текстовых команд (MVP использует текстовые команды, см. раздел 9 брифа)
COMMAND_PREFIX=!
# Путь к файлу SQLite
DATABASE_PATH=data/activity.db
# Единая тайм-зона для нарезки "дней" (раздел 7 брифа). Пример: UTC, Europe/Moscow
AGG_TIMEZONE=UTC

# --- исключения ---
# ID каналов (голосовых и текстовых) через запятую, которые не трекаются
EXCLUDED_CHANNEL_IDS=
# Автоматически исключать AFK-канал гильдии
EXCLUDE_AFK_CHANNEL=true

# --- тонкая настройка ---
# Сессии короче N секунд не засчитываются ("фантомные" сессии, раздел 8 брифа)
MIN_SESSION_SECONDS=10
# Как часто начислять время открытых голосовых сессий (секунды).
# Определяет максимальную потерю данных при аварийном падении бота.
VOICE_FLUSH_INTERVAL=60
# Как часто сбрасывать буфер счётчиков сообщений в БД (секунды)
MESSAGE_FLUSH_INTERVAL=30
# Время жизни кэша лидербордов (секунды)
LEADERBOARD_CACHE_TTL=60
# Считать примерное количество символов (требует intent MESSAGE_CONTENT)
TRACK_CHAR_COUNT=true
# Слэш-команды. Требуют, чтобы бот был приглашён со scope applications.commands.
# Текстовые команды работают независимо от этой настройки.
ENABLE_SLASH_COMMANDS=true

# --- трекинг игр через Rich Presence (раздел 3.3) ---
# ВНИМАНИЕ: перед включением обязательно активируйте в Developer Portal
# оба привилегированных intent — Presence Intent и Server Members Intent,
# иначе бот не сможет войти. Игры не видны у тех, кто отключил показ
# активности в настройках приватности Discord — это ограничение платформы.
ENABLE_PRESENCE_TRACKING=false
# Какие типы активности считать: playing, streaming, listening, watching
TRACKED_ACTIVITY_TYPES=playing
# Период начисления времени открытых игровых сессий (секунды)
PRESENCE_FLUSH_INTERVAL=60

# --- формула комбинированного рейтинга (открытый вопрос 3 из раздела 10) ---
# score = минуты_в_войсе * VOICE_WEIGHT + сообщения * MESSAGE_WEIGHT
# Оба веса — конечные числа >= 0. Ноль убирает составляющую из формулы.
COMBINED_VOICE_WEIGHT=1.0
COMBINED_MESSAGE_WEIGHT=2.0

# --- ретеншн (открытый вопрос 6 из раздела 10) ---
# Сколько дней хранить сырые voice_sessions. Агрегаты в daily_activity_summary
# не удаляются никогда. 0 = не чистить.
RAW_RETENTION_DAYS=90
